DB_CONNECTION_STRING=Server=127.0.0.1;Port=3306;Database=cgm;User Id=cgm;Password=change-me;SslMode=Preferred;
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=CGM.Api
JWT_AUDIENCE=CGM.PatientApp
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=30
API_PORT=5232
